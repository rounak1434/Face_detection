# Starts the stack at boot and after power recovery.
# Install: see docs/SETUP.md ("Start on boot").
[Unit]
Description=AI Surveillance stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ai-surveillance/deploy
# Add "-f compose.yaml -f compose.nvidia.yaml" once the GPU is verified.
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
