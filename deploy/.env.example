# Copy to deploy/.env and fill in. deploy/.env is gitignored; never commit it.
# Restrict it: chmod 600 deploy/.env

# Start the synthetic RTSP test stream with every `docker compose` command.
# Remove this line (or leave it empty) once a real NVR/camera is configured.
COMPOSE_PROFILES=test-stream

# Name shown in the web UI. Change freely; no code changes needed.
APP_DISPLAY_NAME=AI Surveillance

# Host name or IP the browser uses, e.g. surveillance.lan or 192.168.1.50.
# Caddy issues a certificate for it from its own local CA.
SITE_ADDRESS=localhost

TZ=Asia/Kolkata

# Camera streams Frigate reads. Test-stream values are below; for the NVR use
# the RTSP URLs confirmed with `ai-surveillance probe` (see docs/SETUP.md).
# URL-encode special characters in passwords (@ -> %40, / -> %2F, : -> %3A).
FRIGATE_CAMERA_MAIN_URL=rtsp://test-stream:8554/test
FRIGATE_CAMERA_SUB_URL=rtsp://test-stream:8554/test

# Optional: use Frigate's authenticated port instead of the internal one.
# FRIGATE_URL=https://frigate:8971
# FRIGATE_USERNAME=
# FRIGATE_PASSWORD=
# FRIGATE_VERIFY_TLS=false

# Networks the Camera & NVR Setup page may contact for connection tests.
# Narrow this to your camera subnet, e.g. 192.168.1.0/24. 172.16.0.0/12 is
# left out on purpose: Docker uses it for the stack's own internal network.
DEVICE_ALLOWED_NETWORKS=192.168.0.0/16,10.0.0.0/8

SESSION_TTL_HOURS=12
CLIP_DEFAULT_SECONDS=10
CLIP_MAX_SECONDS=60
# Each clip is exported by Frigate, copied into the captures, then deleted
# in Frigate so it does not take disk space twice. true keeps Frigate's copy.
CLIP_KEEP_FRIGATE_EXPORT=false

# Snapshots and clips are stored on the same volume as the database.
# New captures are refused while less than this many MB are free (0 = no check).
CAPTURE_MIN_FREE_MB=1024
# Delete captures older than this many days (checked at startup and hourly).
# 0 keeps them until you delete them in the gallery.
CAPTURE_RETENTION_DAYS=0

# Face events (docs/FACE-EVENTS.md): each finished Frigate person event is checked
# once for faces with the face detector. Faces are compared with the authorized
# people only while recognition is switched on in the app (People page; off by default).
# Frames and face crops are kept only for events with faces, and are deleted after
# FACE_EVENT_RETENTION_DAYS (0 keeps them). FACE_FRAME_SOURCE=recording uses the
# main-stream recording (larger faces), "snapshot" Frigate's detect-stream snapshot.
FACE_EVENTS_ENABLED=true
FACE_EVENT_RETENTION_DAYS=30
FACE_FRAME_SOURCE=recording

# Recognition (docs/RECOGNITION.md). Cosine similarity of face embeddings: at or above
# ACCEPT is "authorized", at or below REJECT "unrecognized", in between "inconclusive".
# These are starting points from public-domain test photos, NOT measured on your
# camera: check them with consenting people before relying on the results.
# REJECT must be below ACCEPT. Faces smaller than RECOGNITION_MIN_FACE_PX are not compared.
RECOGNITION_ACCEPT_THRESHOLD=0.45
RECOGNITION_REJECT_THRESHOLD=0.30
RECOGNITION_MIN_FACE_PX=40
# Smallest face side (px) accepted in an uploaded reference image.
GALLERY_MIN_FACE_PX=80

# Shared secret between the api and the face-analysis container, so no other
# container can use the detector. Generate one per install (SETUP.md §3):
#   sed -i "s/^INFERENCE_API_TOKEN=.*/INFERENCE_API_TOKEN=$(openssl rand -hex 32)/" .env
# Left empty, the detector accepts any caller on the internal network.
INFERENCE_API_TOKEN=

# Network between the web proxy and the api (docker compose only). The api trusts the
# client address forwarded by the proxy only from WEB_EDGE_IP. Change both only if Docker
# reports that the subnet overlaps another network; the address must lie inside the subnet.
# EDGE_SUBNET=172.31.250.0/29
# WEB_EDGE_IP=172.31.250.2

# Memory cap for the face-analysis container (default 1536m). If it is
# exceeded the container restarts (exit code 137 in `docker compose ps`).
# INFERENCE_MEM_LIMIT=1536m
